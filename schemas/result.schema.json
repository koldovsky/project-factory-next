{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["status", "cases"],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["passed", "failed"]},
    "cases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "status"],
      "properties": {"id": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed"]}, "details": {}}
    }},
    "artifacts": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
