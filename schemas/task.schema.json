{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "profile", "title", "intent", "requirements", "checks", "budget"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/definitions/id"},
    "profile": {"$ref": "#/definitions/id"},
    "title": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "context": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "preparation": {"type": "array", "maxItems": 20, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "argv", "timeoutMs"],
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 1800000}
      }
    }},
    "requirements": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "description", "checkIds"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "description": {"type": "string", "minLength": 1},
        "checkIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/id"}}
      }
    }},
    "checks": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "dependsOn", "expectedCases", "timeoutMs"],
      "properties": {
        "id": {"$ref": "#/definitions/id"}, "kind": {"enum": ["command", "visual"]},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/id"}},
        "expectedCases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 1800000},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "config": {"type": "string", "minLength": 1}, "referenceDir": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "command"}}}, "then": {"required": ["argv"], "not": {"anyOf": [{"required": ["config"]}, {"required": ["referenceDir"]}]}}},
        {"if": {"properties": {"kind": {"const": "visual"}}}, "then": {"required": ["config", "referenceDir"], "not": {"required": ["argv"]}}}
      ]
    }},
    "budget": {"type": "object", "additionalProperties": false, "required": ["maxAttempts", "agentTimeoutMs"], "properties": {
      "maxAttempts": {"type": "integer", "minimum": 1, "maximum": 10},
      "agentTimeoutMs": {"type": "integer", "minimum": 100, "maximum": 3600000}
    }}
  },
  "definitions": {"id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,79}$"}}
}
